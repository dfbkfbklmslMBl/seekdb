+# ---------------------------------------------------------------------------
+# AI COLUMN (2026 competition, task 3)
+#
+# __all_ai_column is the per-column registry of asynchronous AI columns.  The
+# result column itself is an ordinary user-visible column of __all_column; the
+# three hidden companion columns (state / request / result spec) are allocated
+# when the AI column is created and their ids are recorded here so that:
+#   - the DML invalidation path knows which hidden columns to write,
+#   - the worker knows which columns to publish in its single "grouped"
+#     transaction,
+#   - ALTER TABLE ... RETRY AI COLUMN can locate the column by name.
+#
+# TODO(verify): 'timestamp' granularity for microsecond comparisons.  The test
+# uses "eligible_ts <= now(6)"; no existing inner table in this ref declares a
+# fractional-second column, so confirm the generated type is timestamp(6) and
+# not truncated to seconds before relying on sub-second ordering.
+# ---------------------------------------------------------------------------
+all_ai_column_def = dict(
+    owner = '2026-competition',
+    table_name = '__all_ai_column',
+    table_id = '1131',
+    table_type = 'SYSTEM_TABLE',
+    gm_columns = ['gmt_create', 'gmt_modified'],
+    rowkey_columns = [
+        ('table_id', 'int'),
+        ('column_id', 'int')
+    ],
+    is_cluster_private = False,
+    meta_record_in_sys = False,
+    normal_columns = [
+        ('database_id', 'int', 'false', '0'),
+        ('column_name', 'varchar:OB_MAX_COLUMN_NAME_LENGTH', 'false', ''),
+        # 3 hidden companion columns, ids allocated together with column_id
+        ('state_column_id', 'int', 'false', '0'),
+        ('request_column_id', 'int', 'false', '0'),
+        ('result_spec_column_id', 'int', 'false', '0'),
+        # generation rule: printed expression with the result-type prompt
+        # already appended (ai_column_ddl.test:72-78 requires
+        # normalized_expr LIKE '%Return exactly one valid JSON value%')
+        ('expression', 'longtext', 'true'),
+        ('normalized_expr', 'longtext', 'true'),
+        ('dep_column_ids', 'longtext', 'true'),   # ordered dependency list
+        ('model_name', 'varchar:128', 'true'),
+        ('func_type', 'int', 'false', '0'),       # AI_COMPLETE / AI_EMBED
+        ('result_type', 'int', 'false', '0'),
+        ('expect_dimension', 'int', 'false', '0'),# vector(N) declared dimension
+        ('sync_mode', 'varchar:32', 'false', 'async'),
+        ('max_retries', 'int', 'false', '0'),
+        ('retry_interval_us', 'int', 'false', '0'),
+        ('definition_version', 'int', 'false', '0'),  # stale-task rejection
+        ('schema_version', 'int', 'false', '0')
+    ]
+)
+
+def_table_schema(**all_ai_column_def)
+
+# Persistent AI column task queue.  Rows are inserted inside the *business*
+# transaction that mutates the dependency columns, which is what gives us
+# "commit then call the model / rollback leaves no task and no request /
+# delete cleans pending tasks" for free (see PLAN.md R1 for how the write is
+# performed).  Terminal states delete the row, so "queue drained" is directly
+# observable from SQL -- several tests assert count(*) = 0.
+def_table_schema(
+    owner = '2026-competition',
+    table_name = '__all_ai_column_task',
+    table_id = '1132',
+    table_type = 'SYSTEM_TABLE',
+    gm_columns = ['gmt_create', 'gmt_modified'],
+    rowkey_columns = [
+        ('table_id', 'int'),
+        ('request_id', 'int'),
+        ('column_id', 'int')
+    ],
+    is_cluster_private = False,
+    meta_record_in_sys = False,
+    normal_columns = [
+        ('database_id', 'int', 'false', '0'),
+        ('tablet_id', 'int', 'false', '0'),
+        # row locator text used for the write-back UPDATE, e.g. "`id` = 2"
+        ('rowkey_predicate', 'varchar:OB_MAX_ERROR_MSG_LEN', 'false', ''),
+        ('state', 'int', 'false', '0'),
+        ('retry_count', 'int', 'false', '0'),
+        ('eligible_ts', 'timestamp', 'true'),
+        # ownership / recovery: which server claimed it and when the lease dies
+        ('owner_server', 'varchar:OB_MAX_SERVER_NAME_LENGTH', 'true'),
+        ('lease_expire_ts', 'timestamp', 'true'),
+        ('definition_version', 'int', 'false', '0'),
+        ('schema_version', 'int', 'false', '0'),
+        ('result_type', 'int', 'false', '0'),
+        ('expect_dimension', 'int', 'false', '0'),
+        ('ret_code', 'int', 'false', '0'),
+        ('trace_id', 'varchar:OB_MAX_ERROR_MSG_LEN', 'true'),
+        ('request_payload', 'longtext', 'true')
+    ]
+)
+
+
